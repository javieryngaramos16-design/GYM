  $("#t-w").classList.toggle("on",S.tab==="w");$("#t-n").classList.toggle("on",S.tab==="n");$("#t-s").classList.toggle("on",S.tab==="s");
  $("#app").innerHTML=S.tab==="w"?viewW():S.tab==="n"?viewN():viewS();
  bind();
}

function dayList(di){
  const d=W[di];
  const arr=d.ex.map((e,i)=>{const b=ex(e),sw=swaps[d.k+"-"+i];
    if(sw){const v=(VARS[e[0]]||[]).find(x=>x[0]===sw);if(v){b.orig=e[0];b.n=v[0];b.t=v[1];b.i=imgs(v[0])}}
    b.base=true;b.bi=i;return b});
  (custom[d.k]||[]).forEach((c,j)=>arr.push({n:c.n,s:c.s,m:c.m||"Personalizado",f:c.f||"press",t:c.t||"Ejercicio personalizado.",i:null,custom:true,cj:j}));
  return arr;
}
function viewW(){
  const day=W[S.day],list=dayList(S.day),key=wk(today),done=((checks[key]&&checks[key][day.k])||[]).filter(i=>i<list.length);
  const pct=list.length?done.length/list.length:0,isToday=(today.getDay()-1)===S.day,tk=dk(today);
  return `<div class="top"><div><h1>Entreno</h1><p class="sub">Semana ${key.split("-W")[1]} · ${day.n}${isToday?" (hoy)":""}</p></div>
  <div class="ring">${ringSVG(pct,"var(--green)")}<span>${done.length}/${list.length}</span></div></div>
  <div class="seg">${W.map((d,i)=>`<button data-day="${i}" class="${i===S.day?"on":""}">${d.n.slice(0,3)}<small>${d.k==="X"?"Piernas":d.t.split(" ")[0]}</small></button>`).join("")}</div>
  <span class="badge">${day.t}${day.foc?" · "+day.foc:""}</span>
  <div class="list">${list.map((e,i)=>{const lg=(logs[tk]||{})[e.n];return `<div class="row ${done.includes(i)?"done":""}">
    <button class="chk" data-chk="${i}" aria-label="Completado">${CHECK}</button>
    <div class="info" data-info="${i}"><div class="nm">${esc(e.n)}</div><div class="mt">${esc(e.m)}${e.orig?" · variante":""}${e.custom?" · personalizado":""}${lg?" · 🏋️ "+fmt(toU(Math.max(...lg.map(s=>s.w))))+" "+unit:""}</div></div>
    <span class="pill">${esc(e.s)}</span>
    <div class="thumb" data-info="${i}">${e.i?`<img src="${e.i[0]}" alt="${esc(e.n)}" loading="lazy">`:FIG[e.f]()}</div></div>`}).join("")}</div>
  ${pct===1?`<p class="sub" style="text-align:center;margin-top:20px;color:var(--green);font-weight:700">🎉 ¡Entrenamiento completado!</p>`:""}
  <button class="btn g" id="addex">＋ Agregar ejercicio</button>
  <button class="btn g" id="reset">Reiniciar checklist del día</button>`;
}

function dayTotals(list){return list.reduce((a,x)=>({kcal:a.kcal+x.kcal,p:a.p+x.p,c:a.c+x.c,f:a.f+x.f}),{kcal:0,p:0,c:0,f:0})}
function viewN(){
  const key=dk(S.date),list=nut[key]||[],T=dayTotals(list);
  const label=S.date.toLocaleDateString("es",{weekday:"long",day:"numeric",month:"long"});
  const isT=key===dk(today);
  const mb=(n,v,g,c)=>`<div><div class="l">${n}</div><div class="v">${Math.round(v)}<small> / ${g} g</small></div><div class="bar"><i style="width:${Math.min(100,v/g*100)}%;background:${c}"></i></div></div>`;
  return `<div class="top"><div><h1>Nutrición</h1><p class="sub">Registro diario</p></div><button class="gear" id="goals" aria-label="Metas">⚙︎</button></div>
  <div class="datebar"><button id="prev">‹</button><div>${isT?"Hoy":label}<small>${isT?label:""}</small></div><button id="next">›</button></div>
  <div class="card"><div class="kcal"><b>${Math.round(T.kcal)}</b><span>/ ${goals.kcal} kcal</span></div>
  <div class="bar"><i style="width:${Math.min(100,T.kcal/goals.kcal*100)}%;background:${T.kcal>goals.kcal?"var(--red)":"var(--orange)"}"></i></div>
  <div class="macros">${mb("Proteínas",T.p,goals.p,"var(--pink)")}${mb("Carbos",T.c,goals.c,"var(--blue)")}${mb("Grasas",T.f,goals.f,"var(--green)")}</div>
  <p class="note" style="margin:12px 0 0">Restan ${Math.max(0,Math.round(goals.kcal-T.kcal))} kcal para tu meta.</p>${prof?"":`<button class="btn g" id="gh" style="margin-top:6px">Calcular mis metas según mi peso y estatura</button>`}</div>
  ${MEALS.map(([id,name,ic])=>{const items=list.filter(x=>x.meal===id),t=dayTotals(items);
   return `<div class="mealh"><b>${ic} ${name}</b><span>${Math.round(t.kcal)} kcal</span></div><div class="list">
   ${items.map(x=>`<div class="row food"><div class="info"><div class="nm">${esc(x.desc)}</div><div class="mt">${x.qty} ${x.unit==="g"?"g":x.qty==1?"porción":"porciones"} · ${Math.round(x.kcal)} kcal · P ${r1(x.p)} · C ${r1(x.c)} · G ${r1(x.f)}</div></div><button class="x" data-del="${x.id}" aria-label="Eliminar">⊖</button></div>`).join("")}
   <button class="add" data-add="${id}"><i>+</i>Añadir alimento</button></div>`}).join("")}`;
}
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

/* ---------- Eventos ---------- */
function bind(){
  const app=$("#app");
  app.querySelectorAll("[data-day]").forEach(b=>b.onclick=()=>{S.day=+b.dataset.day;render()});
  app.querySelectorAll("[data-chk]").forEach(b=>b.onclick=()=>toggle(+b.dataset.chk));
  app.querySelectorAll("[data-info]").forEach(b=>b.onclick=()=>openEx(+b.dataset.info));
  const rs=$("#reset");if(rs)rs.onclick=()=>{const k=wk(today);if(checks[k]){checks[k][W[S.day].k]=[];store.set("ft_checks",checks)}render()};
  app.querySelectorAll("[data-u]").forEach(b=>b.onclick=()=>{unit=b.dataset.u;store.set("ft_unit",unit);render()});
  const ae=$("#addex");if(ae)ae.onclick=openAddEx;
  const se=$("#se");if(se)se.onchange=()=>{S.se=se.value;render()};
  const xb=$("#exp");if(xb)xb.onclick=exportData;
  const ib=$("#imp"),fi=$("#impf");if(ib&&fi){ib.onclick=()=>fi.click();fi.onchange=()=>fi.files[0]&&importData(fi.files[0])}
  app.querySelectorAll("[data-add]").forEach(b=>b.onclick=()=>openAdd(b.dataset.add));
  app.querySelectorAll("[data-del]").forEach(b=>b.onclick=()=>{const k=dk(S.date);nut[k]=(nut[k]||[]).filter(x=>x.id!==b.dataset.del);store.set("ft_nut",nut);render()});
  const mv=n=>{S.date=new Date(S.date.getFullYear(),S.date.getMonth(),S.date.getDate()+n);render()};
  if($("#prev")){$("#prev").onclick=()=>mv(-1);$("#next").onclick=()=>mv(1);$("#goals").onclick=openGoals;const gh=$("#gh");if(gh)gh.onclick=openGoals}
}
function toggle(i){
  const k=wk(today),d=W[S.day].k;checks[k]=checks[k]||{};const a=checks[k][d]=checks[k][d]||[];
  const p=a.indexOf(i);p>=0?a.splice(p,1):a.push(i);store.set("ft_checks",checks);
  if(navigator.vibrate)try{navigator.vibrate(8)}catch(e){}
  render();
}
$("#t-w").onclick=()=>{S.tab="w";render();scrollTo(0,0)};
$("#t-n").onclick=()=>{S.tab="n";render();scrollTo(0,0)};
$("#t-s").onclick=()=>{S.tab="s";render();scrollTo(0,0)};

/* ---------- Sheet ---------- */
function openSheet(h){$("#sheet").innerHTML=`<div class="grab"></div>`+h;$("#ov").classList.add("on");$("#sheet").classList.add("on");$("#sheet").scrollTop=0}
function closeSheet(){$("#ov").classList.remove("on");$("#sheet").classList.remove("on")}
$("#ov").onclick=closeSheet;

const KG=2.20462,toU=k=>unit==="kg"?k:k*KG,fromU=v=>unit==="kg"?v:v/KG,fmt=x=>Math.round(x*10)/10;
function lastLog(name,before){const ks=Object.keys(logs).sort().reverse();for(const k of ks){if(k!==before&&logs[k][name])return{date:k,sets:logs[k][name]}}return null}
function openEx(i){
  const day=W[S.day],e=dayList(S.day)[i],k=wk(today),tk=dk(today),isDone=((checks[k]||{})[day.k]||[]).includes(i);
  const n=parseInt(e.s)||3,cur=(logs[tk]||{})[e.n],last=lastLog(e.n,tk),base=cur||(last&&last.sets)||[];
  const rows=Array.from({length:n},(_,j)=>{const s=base[j];return `<div class="setrow"><span>Serie ${j+1}</span><input type="number" inputmode="decimal" data-w placeholder="0" value="${s?fmt(toU(s.w)):""}"><b class="u">${unit}</b><input type="number" inputmode="numeric" data-r placeholder="reps" value="${s?s.r:""}"></div>`}).join("");
  const demo=e.i?`<div class="flip"><img src="${e.i[0]}" alt="posición inicial"><img class="b2" src="${e.i[1]}" alt="posición final"></div>`:`<div class="figbox">${FIG[e.f]()}</div>`;
  let vhtml="";
  if(e.base){
    const bn=W[S.day].ex[e.bi][0],opts=(VARS[bn]||[]).filter(v=>v[0]!==e.n);
    const item=(name,sub,val)=>{const im=imgs(name);return `<div class="vrow" data-v="${esc(val)}">${im?`<img src="${im[0]}" alt="">`:""}<div><div class="nm">${esc(name)}</div><div class="mt">${esc(sub)}</div></div></div>`};
    vhtml=(opts.length||e.orig)?`<p class="grp-title" style="margin:20px 4px 8px">Variantes del ejercicio</p>${e.orig?item(bn,"Volver al ejercicio original","__orig"):""}${opts.map(v=>item(v[0],v[1],v[0])).join("")}`:"";
  }
  openSheet(`<h2>${esc(e.n)}</h2><div class="mt" style="font-size:15px">${esc(e.m)} · <b style="color:#fff">${esc(e.s)}</b>${e.orig?` · <span style="color:var(--orange)">variante</span>`:""}</div>
  <div class="demo">${demo}</div>${e.i?`<p class="note" style="text-align:center;margin:-6px 0 12px">Posición inicial ⇄ final</p>`:""}<div class="tip">💡 ${esc(e.t)}</div>
  <div style="display:flex;justify-content:space-between;align-items:center;margin:20px 0 10px"><b style="font-size:18px">Peso levantado hoy</b>
  <div class="useg"><button data-u="kg" class="${unit==="kg"?"on":""}">kg</button><button data-u="lb" class="${unit==="lb"?"on":""}">lb</button></div></div>
  ${last&&!cur?`<p class="note" style="margin:0 0 10px">Última vez (${last.date}): ${last.sets.map(s=>fmt(toU(s.w))+unit+" × "+s.r).join(" · ")}</p>`:""}
  ${rows}
  <button class="btn" id="sh-save">Guardar peso y completar</button>
  <button class="btn g" id="sh-done">${isDone?"Marcar como pendiente":"Solo marcar completado"}</button>
  ${vhtml}${e.custom?`<button class="btn g danger" id="sh-del">Eliminar ejercicio</button>`:""}`);
  const sh=$("#sheet");
  sh.querySelectorAll("[data-u]").forEach(b=>b.onclick=()=>{
    if(b.dataset.u===unit)return;
    const vals=[...sh.querySelectorAll("[data-w]")].map(x=>x.value===""?null:fromU(+x.value));
    unit=b.dataset.u;store.set("ft_unit",unit);
    sh.querySelectorAll("[data-w]").forEach((x,j)=>x.value=vals[j]==null?"":fmt(toU(vals[j])));
    sh.querySelectorAll(".u").forEach(u=>u.textContent=unit);
    sh.querySelectorAll("[data-u]").forEach(z=>z.classList.toggle("on",z.dataset.u===unit));
  });
  sh.querySelectorAll("[data-v]").forEach(b=>b.onclick=()=>{const kk=day.k+"-"+e.bi;if(b.dataset.v==="__orig")delete swaps[kk];else swaps[kk]=b.dataset.v;store.set("ft_swaps",swaps);render();openEx(i)});
  $("#sh-save").onclick=()=>{
    const ws=[...sh.querySelectorAll("[data-w]")],rs=[...sh.querySelectorAll("[data-r]")];
    const sets=ws.map((w,j)=>({w:fromU(+w.value||0),r:+rs[j].value||0})).filter(s=>s.w>0);
    logs[tk]=logs[tk]||{};
    if(sets.length)logs[tk][e.n]=sets;else delete logs[tk][e.n];
    store.set("ft_logs",logs);
    if(sets.length&&!isDone){checks[k]=checks[k]||{};const a=checks[k][day.k]=checks[k][day.k]||[];a.push(i);store.set("ft_checks",checks)}
    closeSheet();render();
  };
  $("#sh-done").onclick=()=>{toggle(i);closeSheet()};
  const del=$("#sh-del");
  if(del)del.onclick=()=>{if(!confirm("¿Eliminar este ejercicio?"))return;
    custom[day.k].splice(e.cj,1);const idx=day.ex.length+e.cj;
    Object.keys(checks).forEach(w=>{const a=checks[w][day.k];if(a)checks[w][day.k]=a.filter(x=>x!==idx).map(x=>x>idx?x-1:x)});
    store.set("ft_custom",custom);store.set("ft_checks",checks);closeSheet();render()};
}

const MOVES=[["press","Empuje / press"],["fly","Aperturas"],["pull","Jalón vertical"],["row","Remo"],["curl","Curl de bíceps"],["tri","Extensión de tríceps"],["squat","Sentadilla / prensa"],["leg","Piernas en máquina"],["calf","Gemelos"],["core","Abdomen"],["plank","Isométrico / plancha"]];
function openAddEx(){
  openSheet(`<h2>Nuevo ejercicio</h2><p class="note" style="margin:4px 0 14px">Agrégalo a cualquier día de tu rutina. Después podrás registrar tus pesos igual que en los demás.</p>
  <div class="field"><label>Nombre</label><input id="n-n" placeholder="Ej. Press Arnold"></div>
  <div class="field"><label>Día</label><select id="n-d">${W.map((d,i)=>`<option value="${i}" ${i===S.day?"selected":""}>${d.n} · ${d.t}</option>`).join("")}</select></div>
  <div class="two"><div class="field"><label>Series × reps</label><input id="n-s" value="3 × 10"></div><div class="field"><label>Músculo</label><input id="n-m" placeholder="Hombro"></div></div>
  <div class="field"><label>Movimiento</label><select id="n-f">${MOVES.map(m=>`<option value="${m[0]}">${m[1]}</option>`).join("")}</select></div>
  <div class="field"><label>Notas</label><input id="n-t" placeholder="Opcional (técnica)"></div>
  <p class="note">El dibujo animado que verás depende del tipo de movimiento elegido.</p>
  <button class="btn" id="n-save">Agregar ejercicio</button><button class="btn g" id="n-cancel">Cancelar</button>`);
  const g=id=>$("#"+id);g("n-cancel").onclick=closeSheet;
  g("n-save").onclick=()=>{const nm=g("n-n").value.trim();if(!nm){g("n-n").focus();return}
    const di=+g("n-d").value,dk_=W[di].k;custom[dk_]=custom[dk_]||[];
    custom[dk_].push({n:nm,s:g("n-s").value.trim()||"3 × 10",m:g("n-m").value.trim()||"Personalizado",f:g("n-f").value,t:g("n-t").value.trim()});
    store.set("ft_custom",custom);S.day=di;closeSheet();render()};
}

function exportData(){
  const data={app:"fittrack",v:1,checks,nut,goals,logs,unit,prof,swaps,custom};
  const a=document.createElement("a");a.href=URL.createObjectURL(new Blob([JSON.stringify(data)],{type:"application/json"}));
  a.download="fittrack-respaldo-"+dk(today)+".json";document.body.appendChild(a);a.click();a.remove();
}
function importData(f){
  const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(d.app!=="fittrack")throw 0;
    checks=d.checks||{};nut=d.nut||{};goals=d.goals||goals;logs=d.logs||{};unit=d.unit||"kg";prof=d.prof||null;swaps=d.swaps||{};custom=d.custom||{};
    store.set("ft_checks",checks);store.set("ft_nut",nut);store.set("ft_goals",goals);store.set("ft_logs",logs);store.set("ft_unit",unit);store.set("ft_prof",prof);store.set("ft_swaps",swaps);store.set("ft_custom",custom);
    render();alert("Respaldo importado correctamente.")}catch(e){alert("El archivo no es un respaldo válido de FitTrack.")}};
  r.readAsText(f);
}

function openAdd(meal){
  const name=MEALS.find(m=>m[0]===meal)[1];
  openSheet(`<h2>Añadir a ${name}</h2><p class="note" style="margin:4px 0 12px">Busca o despliega la lista, elige el alimento y la cantidad. Los valores se calculan solos.</p>
  <div class="field"><input id="q" placeholder="🔍 Buscar (arroz, pollo, huevo…)" style="text-align:left" autocomplete="off"></div>
  <div id="res" class="res"></div><div id="sel"></div>
  <button class="btn g" id="man">Ingresar alimento manualmente</button>`);
  const g=id=>$("#"+id);
  const showRes=()=>{const t=norm(g("q").value.trim());const L=FOODS.filter(f=>!t||f.k.includes(t));
    g("res").innerHTML=L.length?L.map(f=>`<div class="rr" data-f="${f.id}"><div class="nm" style="font-size:15px">${f.n}</div><div class="mt">${f.kcal} kcal · P ${f.p} · C ${f.c} · G ${f.f} <span style="opacity:.6">/ 100 g</span></div></div>`).join(""):`<p class="note" style="padding:12px">Sin resultados. Prueba otro nombre o ingrésalo manualmente.</p>`;
    g("res").querySelectorAll("[data-f]").forEach(r=>r.onclick=()=>pick(FOODS[+r.dataset.f]))};
  g("q").oninput=showRes;showRes();
  g("man").onclick=()=>openCustom(meal);
  function pick(f){
    g("res").style.display="none";g("q").parentElement.style.display="none";g("man").style.display="none";
    g("sel").innerHTML=`<div class="card"><div class="nm" style="font-size:19px;margin-bottom:12px">${f.n}</div>
    <div class="two"><div class="field"><label>Cantidad</label><input id="sq" type="number" inputmode="decimal" value="${f.pg?1:100}"></div>
    <div class="field"><label>Unidad</label><select id="su">${f.pg?`<option value="p">porción</option>`:""}<option value="g">gramos</option></select></div></div>
    <p class="note" id="sn" style="margin:-2px 4px 8px"></p>
    <div class="chips"><button data-g="50">50 g</button><button data-g="100">100 g</button><button data-g="150">150 g</button><button data-g="200">200 g</button></div>
    <div class="macros" style="grid-template-columns:repeat(4,1fr);margin-top:6px" id="pv"></div></div>
    <button class="btn" id="sv">Añadir</button><button class="btn g" id="bk">Elegir otro alimento</button>`;
    const calc=()=>{const q=+g("sq").value||0,u=g("su").value,gr=u==="g"?q:q*f.pg,x=gr/100;
      g("sn").textContent=u==="p"?`1 porción = ${f.pl} ≈ ${f.pg} g · total ${Math.round(gr)} g`:"";
      const v={kcal:f.kcal*x,p:f.p*x,c:f.c*x,f:f.f*x};
      g("pv").innerHTML=[["Calorías",Math.round(v.kcal),""],["Prot.",r1(v.p),"g"],["Carbos",r1(v.c),"g"],["Grasas",r1(v.f),"g"]].map(a=>`<div><div class="l">${a[0]}</div><div class="v" style="font-size:18px">${a[1]}<small>${a[2]}</small></div></div>`).join("");return v};
    g("sq").oninput=calc;g("su").onchange=calc;
    g("sel").querySelectorAll("[data-g]").forEach(b=>b.onclick=()=>{g("su").value="g";g("sq").value=b.dataset.g;calc()});
    g("bk").onclick=()=>openAdd(meal);
    g("sv").onclick=()=>{const v=calc(),q=+g("sq").value;if(!q)return;
      const e={id:Date.now()+""+Math.random().toString(36).slice(2,6),meal,desc:f.n,qty:q,unit:g("su").value,kcal:r1(v.kcal),p:r1(v.p),c:r1(v.c),f:r1(v.f)};
      const k=dk(S.date);nut[k]=nut[k]||[];nut[k].push(e);store.set("ft_nut",nut);closeSheet();render()};
    calc();
  }
}

