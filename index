<title>FitTrack</title>
<style>
:root{--bg:#000;--card:#1c1c1e;--card2:#2c2c2e;--sep:#38383a;--tx:#fff;--tx2:#8e8e93;--blue:#0a84ff;--green:#30d158;--orange:#ff9f0a;--red:#ff453a;--pink:#ff375f;--font:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Segoe UI",Roboto,Helvetica,Arial,sans-serif}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--tx);font-family:var(--font)}
body{min-height:100vh;-webkit-font-smoothing:antialiased}
#app{max-width:520px;margin:0 auto;padding:calc(env(safe-area-inset-top) + 12px) 16px 130px}
h1{font-size:34px;letter-spacing:-.6px;margin:8px 0 2px;font-weight:800}
.sub{color:var(--tx2);font-size:15px;margin:0 0 16px}
.top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.ring{position:relative;width:58px;height:58px;flex:none;margin-top:6px}
.ring svg{transform:rotate(-90deg)}
.ring span{position:absolute;inset:0;display:grid;place-items:center;font-size:13px;font-weight:700}
.seg{display:flex;background:var(--card);border-radius:10px;padding:2px;margin-bottom:18px;position:sticky;top:0;z-index:5}
.seg button{flex:1;border:0;background:none;color:var(--tx);font:600 13px var(--font);padding:8px 0;border-radius:8px;cursor:pointer;transition:.2s}
.seg button.on{background:var(--card2);box-shadow:0 2px 6px #0008}
.seg button small{display:block;font-weight:500;color:var(--tx2);font-size:10px;margin-top:1px}
.badge{display:inline-block;background:#0a84ff26;color:var(--blue);font-size:12px;font-weight:700;padding:4px 10px;border-radius:20px;margin-bottom:14px}
.grp-title{font-size:13px;color:var(--tx2);text-transform:uppercase;letter-spacing:.4px;margin:18px 14px 6px}
.list{background:var(--card);border-radius:14px;overflow:hidden}
.row{display:flex;align-items:center;gap:12px;padding:12px 14px;border-bottom:.5px solid var(--sep);min-height:64px}
.row:last-child{border-bottom:0}
.chk{width:28px;height:28px;border-radius:50%;border:2px solid #48484a;background:none;flex:none;display:grid;place-items:center;cursor:pointer;transition:.2s;padding:0}
.chk svg{opacity:0;transform:scale(.4);transition:.2s}
.done .chk{background:var(--green);border-color:var(--green)}
.done .chk svg{opacity:1;transform:none}
.done .nm{color:var(--tx2);text-decoration:line-through}
.info{flex:1;min-width:0;cursor:pointer}
.nm{font-size:16px;font-weight:600;transition:.2s}
.mt{font-size:13px;color:var(--tx2);margin-top:2px}
.pill{background:var(--card2);border-radius:8px;padding:6px 10px;font-size:13px;font-weight:700;white-space:nowrap}
.thumb{width:56px;height:56px;border-radius:10px;background:var(--card2);flex:none;display:grid;place-items:center;cursor:pointer}
.thumb{overflow:hidden}.thumb img{width:100%;height:100%;object-fit:cover}.flip{position:relative;width:100%;max-width:360px;aspect-ratio:1/1;border-radius:12px;overflow:hidden;background:#fff}.flip img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}.flip .b2{animation:fl 1.8s steps(1) infinite}@keyframes fl{0%{opacity:0}50%{opacity:1}100%{opacity:0}}
.chev{color:#48484a}
.tabbar{position:fixed;left:0;right:0;bottom:0;background:#1c1c1ecc;backdrop-filter:blur(24px) saturate(1.8);-webkit-backdrop-filter:blur(24px) saturate(1.8);border-top:.5px solid var(--sep);display:flex;justify-content:center;padding:8px 0 calc(env(safe-area-inset-bottom) + 6px);z-index:20}
.tabbar div{display:flex;width:100%;max-width:520px}
.tabbar button{flex:1;background:none;border:0;color:var(--tx2);font:600 10px var(--font);display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer}
.tabbar button.on{color:var(--blue)}
.tabbar svg{width:26px;height:26px}
.card{background:var(--card);border-radius:14px;padding:16px;margin-bottom:12px}
.kcal{display:flex;align-items:baseline;gap:6px}
.kcal b{font-size:44px;letter-spacing:-1px}
.kcal span{color:var(--tx2);font-size:15px}
.bar{height:8px;background:var(--card2);border-radius:5px;overflow:hidden;margin-top:8px}
.bar i{display:block;height:100%;border-radius:5px;transition:width .4s}
.macros{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}
.macros .l{font-size:12px;color:var(--tx2);font-weight:600}
.macros .v{font-size:20px;font-weight:700;margin-top:2px}
.macros .v small{font-size:12px;color:var(--tx2);font-weight:500}
.datebar{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.datebar button{background:var(--card);border:0;color:var(--blue);width:38px;height:38px;border-radius:50%;font-size:20px;cursor:pointer}
.datebar div{font-weight:700;font-size:16px;text-align:center;text-transform:capitalize}
.datebar small{display:block;color:var(--tx2);font-weight:500;font-size:12px}
.mealh{display:flex;justify-content:space-between;align-items:baseline;margin:20px 14px 6px}
.mealh b{font-size:20px;letter-spacing:-.3px}.mealh span{color:var(--tx2);font-size:13px}
.food .nm{font-size:15px}
.x{background:none;border:0;color:var(--red);font-size:22px;cursor:pointer;padding:6px;flex:none}
.add{display:flex;align-items:center;gap:10px;padding:13px 14px;color:var(--blue);font-weight:600;font-size:16px;cursor:pointer;border:0;background:none;width:100%;text-align:left;font-family:var(--font)}
.add i{width:24px;height:24px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;font-style:normal;font-size:18px;line-height:1}
.ov{position:fixed;inset:0;background:#0009;opacity:0;pointer-events:none;transition:.3s;z-index:40}
.ov.on{opacity:1;pointer-events:auto}
.sheet{position:fixed;left:50%;bottom:0;width:100%;max-width:520px;transform:translate(-50%,105%);background:#1c1c1e;border-radius:22px 22px 0 0;z-index:50;transition:transform .38s cubic-bezier(.2,.9,.25,1);max-height:92vh;overflow:auto;padding:8px 18px calc(env(safe-area-inset-bottom) + 22px)}
.sheet.on{transform:translate(-50%,0)}
.grab{width:38px;height:5px;background:#48484a;border-radius:3px;margin:4px auto 14px}
.sheet h2{margin:0 0 4px;font-size:24px;letter-spacing:-.4px}
.demo{background:#000;border-radius:16px;margin:14px 0;display:grid;place-items:center;padding:10px}
.demo svg{width:100%;max-width:260px;height:auto}
.demo svg .b{stroke:#aeaeb2}.demo svg .m{stroke:#30d158}.demo svg .fl{fill:#aeaeb2;stroke:none}
.tip{background:var(--card2);border-radius:12px;padding:12px 14px;font-size:14px;line-height:1.45;color:#e5e5ea}
.btn{width:100%;border:0;background:var(--blue);color:#fff;font:700 17px var(--font);padding:15px;border-radius:14px;margin-top:14px;cursor:pointer}
.btn.g{background:var(--card2);color:var(--blue)}
.field{background:var(--card2);border-radius:12px;padding:0 14px;margin-bottom:10px;display:flex;align-items:center;gap:10px;height:48px}
.field label{color:var(--tx2);font-size:14px;width:92px;flex:none}
.field input,.field select{flex:1;min-width:0;background:none;border:0;outline:0;color:#fff;font:16px var(--font);text-align:right}
.field select option{background:#2c2c2e}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.two .field label{width:auto}
.note{font-size:12px;color:var(--tx2);margin:2px 6px 10px}
.gear{background:var(--card);border:0;color:var(--blue);width:38px;height:38px;border-radius:50%;cursor:pointer;font-size:18px}
.rest{text-align:center;color:var(--tx2);padding:40px 20px}
.res{max-height:250px;overflow:auto;background:var(--card2);border-radius:12px;margin-bottom:10px}.rr{padding:11px 14px;border-bottom:.5px solid var(--sep);cursor:pointer}.rr:last-child{border:0}.rr:active{background:#3a3a3c}
.chips{display:flex;gap:8px;margin:0 0 12px}.chips button{flex:1;background:var(--card2);border:0;color:var(--blue);font:600 14px var(--font);padding:8px;border-radius:10px;cursor:pointer}
.setrow{display:grid;grid-template-columns:58px 1fr 26px 1fr;gap:8px;align-items:center;margin-bottom:8px;font-size:14px;color:var(--tx2)}
.setrow input{background:var(--card2);border:0;border-radius:10px;color:#fff;font:16px var(--font);padding:11px;width:100%;text-align:center;outline:0}
.useg{display:inline-flex;background:var(--card2);border-radius:9px;padding:2px}.useg button{border:0;background:none;color:var(--tx2);font:600 13px var(--font);padding:5px 14px;border-radius:7px;cursor:pointer}.useg button.on{background:#48484a;color:#fff}
.split{display:flex;height:14px;border-radius:7px;overflow:hidden;margin:12px 0;background:var(--card2)}.split i{display:block;height:100%}
.card h3{margin:0 0 10px;font-size:17px}.rec{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:.5px solid var(--sep);font-size:15px}.rec:last-child{border:0}.rec b{white-space:nowrap}

.thumb svg{width:40px;height:40px}.thumb svg .b{stroke:#aeaeb2}.thumb svg .m{stroke:#30d158}.thumb svg .fl{fill:#aeaeb2;stroke:none}
.figbox{width:100%;max-width:240px}.figbox svg{width:100%}
.vrow{display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--card2);border-radius:12px;margin-bottom:8px;cursor:pointer}.vrow:active{background:#3a3a3c}
.vrow img{width:52px;height:52px;border-radius:8px;object-fit:cover;background:#fff;flex:none}.vrow .mt{font-size:12px}
.btn.danger{background:#ff453a22;color:var(--red)}
input,select,button{font-family:var(--font)}

</style>
</head>
