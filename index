    const k=dk(S.date);nut[k]=nut[k]||[];nut[k].push(e);store.set("ft_nut",nut);closeSheet();render()};
}

function lastDays(n){const a=[];for(let j=n-1;j>=0;j--)a.push(new Date(today.getFullYear(),today.getMonth(),today.getDate()-j));return a}
function bars(vals,labs,color,goal){
  const max=Math.max(goal||0,...vals,1)*1.15,bw=320/vals.length;
  return `<svg viewBox="0 0 320 165" width="100%" style="display:block">${vals.map((v,i)=>{const h=v/max*120;return `<rect x="${i*bw+bw*.18}" y="${132-h}" width="${bw*.64}" height="${Math.max(h,v?2:0)}" rx="5" fill="${color}"/><text x="${i*bw+bw/2}" y="${125-h}" text-anchor="middle" fill="#8e8e93" font-size="10">${v?fmt(v):""}</text><text x="${i*bw+bw/2}" y="152" text-anchor="middle" fill="#8e8e93" font-size="11">${labs[i]}</text>`}).join("")}
  ${goal?`<line x1="0" x2="320" y1="${132-goal/max*120}" y2="${132-goal/max*120}" stroke="#ff9f0a" stroke-dasharray="4 4"/><text x="318" y="${126-goal/max*120}" text-anchor="end" fill="#ff9f0a" font-size="10">meta</text>`:""}</svg>`;
}
function viewS(){
  const days=lastDays(7),L=d=>["D","L","M","X","J","V","S"][d.getDay()];
  const T=days.map(d=>dayTotals(nut[dk(d)]||[])),act=T.filter(t=>t.kcal>0),nA=act.length||1;
  const avg=k=>act.reduce((s,t)=>s+t[k],0)/nA;
  const P=avg("p")*4,C=avg("c")*4,F=avg("f")*9,tot=(P+C+F)||1;
  const pc=x=>Math.round(x/tot*100);
  const vol=days.map(d=>{const l=logs[dk(d)]||{};return Object.values(l).reduce((s,sets)=>s+sets.reduce((a,x)=>a+x.w*x.r,0),0)});
  const volU=vol.map(v=>toU(v));
  const key=wk(today),wc=checks[key]||{},done=W.reduce((s,d)=>s+((wc[d.k]||[]).length),0),totalEx=W.reduce((s,d)=>s+d.ex.length,0);
  const rec={};Object.values(logs).forEach(day=>Object.entries(day).forEach(([n,sets])=>sets.forEach(s=>{if(!rec[n]||s.w>rec[n].w)rec[n]=s})));
  const recs=Object.entries(rec).sort((a,b)=>b[1].w-a[1].w).slice(0,10);
  const names=[...new Set(Object.values(logs).flatMap(d=>Object.keys(d)))].sort();
  if(!S.se||!names.includes(S.se))S.se=names[0];
  let progress="";
  if(names.length){const sess=Object.keys(logs).sort().filter(k=>logs[k][S.se]).slice(-8);
    const tops=sess.map(k=>toU(Math.max(...logs[k][S.se].map(s=>s.w)))),vols=sess.map(k=>logs[k][S.se].reduce((a,s)=>a+s.w*s.r,0));
    const first=tops[0],lastv=tops[tops.length-1],diff=first?((lastv-first)/first*100):0;
    progress=`<div class="card"><h3>📈 Progreso por ejercicio</h3><div class="field" style="margin-bottom:6px"><select id="se" style="text-align:left">${names.map(n=>`<option value="${esc(n)}" ${n===S.se?"selected":""}>${esc(n)}</option>`).join("")}</select></div>
    ${bars(tops,sess.map(k=>k.slice(8)+"/"+k.slice(5,7)),"var(--blue)",0)}
    <p class="note" style="margin:6px 0 0">Mejor peso por sesión (${unit}). ${sess.length>1?`Cambio: <b style="color:${diff>=0?"var(--green)":"var(--red)"}">${diff>=0?"+":""}${fmt(diff)}%</b> · Volumen última sesión: ${Math.round(toU(vols[vols.length-1])).toLocaleString("es")} ${unit}`:"Registra más sesiones para ver tu progreso."}</p></div>`}
  const backup=`<div class="card"><h3>💾 Respaldo de datos</h3><p class="note" style="margin:0 0 10px">Tus datos viven en este navegador. Descarga un respaldo para no perderlos o llevarlos a otro dispositivo.</p>
    <div class="two"><button class="btn g" id="exp" style="margin:0">Exportar</button><button class="btn g" id="imp" style="margin:0">Importar</button></div><input type="file" id="impf" accept="application/json" hidden></div>`;
  return `<div class="top"><div><h1>Estadísticas</h1><p class="sub">Últimos 7 días</p></div>
  <div class="useg" style="margin-top:12px"><button data-u="kg" class="${unit==="kg"?"on":""}">kg</button><button data-u="lb" class="${unit==="lb"?"on":""}">lb</button></div></div>
  <div class="card"><h3>🔥 Calorías por día</h3>${bars(T.map(t=>t.kcal),days.map(L),"var(--orange)",goals.kcal)}
  <p class="note" style="margin:6px 0 0">Promedio: <b style="color:#fff">${Math.round(avg("kcal"))} kcal</b> (${act.length} día${act.length===1?"":"s"} con registro) · Meta ${goals.kcal}</p></div>
  <div class="card"><h3>🥩 Macronutrientes (promedio diario)</h3>
  <div class="macros" style="margin-top:0"><div><div class="l">Proteínas</div><div class="v">${Math.round(avg("p"))}<small> g</small></div></div><div><div class="l">Carbos</div><div class="v">${Math.round(avg("c"))}<small> g</small></div></div><div><div class="l">Grasas</div><div class="v">${Math.round(avg("f"))}<small> g</small></div></div></div>
  <div class="split"><i style="width:${pc(P)}%;background:var(--pink)"></i><i style="width:${pc(C)}%;background:var(--blue)"></i><i style="width:${pc(F)}%;background:var(--green)"></i></div>
  <p class="note" style="margin:0"><span style="color:var(--pink)">●</span> Prot ${pc(P)}% &nbsp;<span style="color:var(--blue)">●</span> Carbos ${pc(C)}% &nbsp;<span style="color:var(--green)">●</span> Grasas ${pc(F)}%</p></div>
  <div class="card"><h3>🏋️ Peso total levantado (${unit})</h3>${bars(volU,days.map(L),"var(--green)",0)}
  <p class="note" style="margin:6px 0 0">Volumen = peso × repeticiones. Total de la semana: <b style="color:#fff">${Math.round(volU.reduce((a,b)=>a+b,0)).toLocaleString("es")} ${unit}</b></p></div>
  <div class="card"><h3>✅ Semana actual</h3><div class="kcal"><b>${done}</b><span>/ ${totalEx} ejercicios completados</span></div>
  <div class="bar"><i style="width:${done/totalEx*100}%;background:var(--green)"></i></div>
  <div class="macros" style="grid-template-columns:repeat(5,1fr)">${W.map(d=>`<div><div class="l">${d.n.slice(0,3)}</div><div class="v" style="font-size:16px">${(wc[d.k]||[]).length}<small>/${d.ex.length}</small></div></div>`).join("")}</div></div>
  ${progress}<div class="card"><h3>🏆 Récords personales</h3>${recs.length?recs.map(([n,s])=>`<div class="rec"><span>${n}</span><b>${fmt(toU(s.w))} ${unit} × ${s.r}</b></div>`).join(""):`<p class="note" style="margin:0">Aún no hay pesos registrados. Ábrelos desde cualquier ejercicio en la pestaña Entreno.</p>`}</div>${backup}`;
}

function calcGoals(pr){
  const bmr=10*pr.kg+6.25*pr.cm-5*pr.age+(pr.sex==="m"?5:-161),tdee=bmr*pr.act;
  const adj={cut:-0.18,keep:0,bulk:0.10}[pr.obj],kcal=Math.round(tdee*(1+adj)/10)*10;
  const p=Math.round(pr.kg*(pr.obj==="cut"?2.2:1.8)),f=Math.round(pr.kg*(pr.obj==="cut"?0.8:0.9)),c=Math.max(0,Math.round((kcal-p*4-f*9)/4));
  return{bmr:Math.round(bmr),tdee:Math.round(tdee),kcal,p,c,f};
}
function openGoals(){
  const pr=prof||{sex:"m",age:25,kg:"",cm:"",act:1.55,obj:"bulk"};
  const sel=(v,c)=>v==c?"selected":"";
  openSheet(`<h2>Mi perfil y metas</h2><p class="note" style="margin:4px 0 14px">Ingresa tus datos y calculo tus calorías y macros diarios (fórmula Mifflin-St Jeor).</p>
  <div class="field"><label>Sexo</label><select id="p-s"><option value="m" ${sel(pr.sex,"m")}>Hombre</option><option value="f" ${sel(pr.sex,"f")}>Mujer</option></select></div>
  <div class="two"><div class="field"><label>Edad</label><input id="p-a" type="number" inputmode="numeric" value="${pr.age}"></div>
  <div class="field"><label>Estatura cm</label><input id="p-h" type="number" inputmode="decimal" placeholder="170" value="${pr.cm}"></div></div>
  <div class="field"><label>Peso <span class="u" style="color:var(--blue)">${unit}</span></label><input id="p-w" type="number" inputmode="decimal" placeholder="70" value="${pr.kg?fmt(toU(pr.kg)):""}">
  <div class="useg"><button data-u="kg" class="${unit==="kg"?"on":""}">kg</button><button data-u="lb" class="${unit==="lb"?"on":""}">lb</button></div></div>
  <div class="field"><label>Actividad</label><select id="p-x"><option value="1.375" ${sel(pr.act,1.375)}>Ligera (1-3 días)</option><option value="1.55" ${sel(pr.act,1.55)}>Moderada (4-5 días)</option><option value="1.725" ${sel(pr.act,1.725)}>Alta (6-7 días)</option></select></div>
  <div class="field"><label>Objetivo</label><select id="p-o"><option value="bulk" ${sel(pr.obj,"bulk")}>Ganar músculo</option><option value="keep" ${sel(pr.obj,"keep")}>Mantener</option><option value="cut" ${sel(pr.obj,"cut")}>Definir / bajar grasa</option></select></div>
  <button class="btn" id="p-calc">Calcular mis metas</button>
  <div id="p-res"></div>
  <p class="grp-title" style="margin:18px 0 6px">Metas diarias (editables)</p>
  <div class="two"><div class="field"><label>Calorías</label><input id="g-k" type="number" value="${goals.kcal}"></div><div class="field"><label>Prot. g</label><input id="g-p" type="number" value="${goals.p}"></div></div>
  <div class="two"><div class="field"><label>Carbos g</label><input id="g-c" type="number" value="${goals.c}"></div><div class="field"><label>Grasas g</label><input id="g-f" type="number" value="${goals.f}"></div></div>
  <button class="btn" id="g-save">Guardar</button>`);
  const sh=$("#sheet"),g=id=>$("#"+id);
  sh.querySelectorAll("[data-u]").forEach(b=>b.onclick=()=>{if(b.dataset.u===unit)return;const v=g("p-w").value===""?null:fromU(+g("p-w").value);unit=b.dataset.u;store.set("ft_unit",unit);g("p-w").value=v==null?"":fmt(toU(v));sh.querySelector(".u").textContent=unit;sh.querySelectorAll("[data-u]").forEach(z=>z.classList.toggle("on",z.dataset.u===unit))});
  const read=()=>({sex:g("p-s").value,age:+g("p-a").value,cm:+g("p-h").value,kg:fromU(+g("p-w").value),act:+g("p-x").value,obj:g("p-o").value});
  g("p-calc").onclick=()=>{const p=read();if(!p.kg||!p.cm||!p.age){g("p-res").innerHTML=`<p class="note" style="color:var(--orange)">Completa edad, estatura y peso.</p>`;return}
    const r=calcGoals(p),imc=p.kg/Math.pow(p.cm/100,2);
    g("g-k").value=r.kcal;g("g-p").value=r.p;g("g-c").value=r.c;g("g-f").value=r.f;
    g("p-res").innerHTML=`<div class="card" style="margin-top:12px"><div class="mt">Metabolismo basal ${r.bmr} kcal · Gasto total ${r.tdee} kcal · IMC ${fmt(imc)}</div>
    <div class="kcal" style="margin-top:6px"><b style="font-size:36px">${r.kcal}</b><span>kcal/día</span></div>
    <div class="macros"><div><div class="l">Proteínas</div><div class="v">${r.p}<small> g</small></div></div><div><div class="l">Carbos</div><div class="v">${r.c}<small> g</small></div></div><div><div class="l">Grasas</div><div class="v">${r.f}<small> g</small></div></div></div></div>`};
  g("g-save").onclick=()=>{const p=read();if(p.kg&&p.cm&&p.age){prof=p;store.set("ft_prof",prof)}
    goals={kcal:+g("g-k").value||2500,p:+g("g-p").value||160,c:+g("g-c").value||300,f:+g("g-f").value||70};store.set("ft_goals",goals);closeSheet();render()};
}

render();

</script>
</body>
</html>
